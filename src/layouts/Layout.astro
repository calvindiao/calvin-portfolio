---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/martian-mono/standard.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { ArrowUpRight, Copy, X } from '@lucide/astro';
import { site } from '../data/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; }
const { title, description = 'Calvin Diao is a software engineer: Chromium contributor (Google Summer of Code 2025), ex-General Motors and Samsung R&D, M.Eng. McMaster. Projects from competition robots and motion capture to AR video calling and browser internals.', image = '/share.png' } = Astro.props;
const pageTitle = title ? `${title} · Calvin Diao` : 'Calvin Diao · Software engineer, from circuit boards to Chromium';
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const nav = [
  { href: '/#projects', label: 'Projects', active: current.startsWith('/projects/') },
  { href: '/about/', label: 'About', active: current === '/about/' },
  { href: '/writing/', label: 'Writing', active: current === '/writing/', optional: true }
];
const year = new Date().getUTCFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAFAF9" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:site_name" content="Calvin Diao" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/media/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="shell masthead-row">
        <a class="brand" href="/" aria-label="Calvin Diao, home">Calvin Diao</a>
        <nav class="nav" aria-label="Main">
          {nav.map(item => <a href={item.href} class:list={{ 'nav-optional': item.optional }} aria-current={item.active ? 'page' : undefined}>{item.label}</a>)}
          <a class="nav-cta" href="#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="shell contact-inner">
        <h2 id="contact-title">Contact</h2>
        <div class="contact-body">
          <div class="contact-email">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <button class="button copy-button js-only" type="button" data-copy={site.email}><Copy size={14} aria-hidden="true" /><span data-copy-label>Copy</span></button>
          </div>
          <ul class="contact-links">
            <li><a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<ArrowUpRight size={14} aria-hidden="true" /></a></li>
            <li><a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub<ArrowUpRight size={14} aria-hidden="true" /></a></li>
            <li><a href={site.links.youtube} target="_blank" rel="noopener noreferrer">YouTube<ArrowUpRight size={14} aria-hidden="true" /></a></li>
            <li><a href={site.links.chromium} target="_blank" rel="noopener noreferrer">Chromium code reviews<ArrowUpRight size={14} aria-hidden="true" /></a></li>
          </ul>
        </div>
      </div>
    </section>
    <footer class="footer">
      <div class="shell footer-row">
        <p>© {year} Calvin Diao</p>
        <ul class="footer-nav">
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/writing/">Writing</a></li>
        </ul>
        <p class="footer-license">Writing and photos: <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>. Code: Apache-2.0.</p>
      </div>
    </footer>
    <dialog class="lightbox" aria-label="Expanded image">
      <button class="lightbox-close" type="button" aria-label="Close image">Close <X size={16} aria-hidden="true" /></button>
      <img alt="" /><p class="lightbox-caption"></p>
    </dialog>
    <script>import '../scripts/interactions';</script>
  </body>
</html>
