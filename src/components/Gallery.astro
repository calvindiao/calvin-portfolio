---
import { Maximize2 } from '@lucide/astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { getImage } from '../data/images';
interface Props { images: string[]; }
const { images } = Astro.props;
---
<div class:list={['gallery', `gallery-${Math.min(images.length, 3)}`]}>
  {images.map(key => {
    const image = getImage(key);
    return (
      <figure class="gallery-item">
        <a class="gallery-link" href={image.src} data-image={image.src} data-alt={image.alt} aria-label={`Enlarge: ${image.alt}`}>
          <ResponsiveImage image={key} sizes="(max-width: 700px) 92vw, 40vw" />
          <span class="gallery-zoom" aria-hidden="true"><Maximize2 size={15} /></span>
        </a>
        <figcaption class="media-caption">{image.alt}</figcaption>
      </figure>
    );
  })}
</div>
