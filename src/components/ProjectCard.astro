---
// One project on the home page: the picture, the credential, the title and one sentence.
// The title link stretches over the whole card, so the card is one click target with a short accessible name.
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, Award, CodeXml, GraduationCap, Play, Trophy } from '@lucide/astro';
import ResponsiveImage from './ResponsiveImage.astro';
import ChromiumFigure from './ChromiumFigure.astro';
interface Props { project: CollectionEntry<'projects'>; size?: 'large' | 'small' | 'wide'; heading?: 'h2' | 'h3'; }
const { project, size = 'small', heading = 'h3' } = Astro.props;
const { title, summary, year, field, cover, coverAlt, video, badge } = project.data;
const BadgeIcon = { trophy: Trophy, award: Award, graduation: GraduationCap, code: CodeXml }[badge.icon];
const Heading = heading;
const sizes = size === 'large' ? '(max-width: 760px) 92vw, (max-width: 1100px) 46vw, 570px' : '(max-width: 760px) 92vw, (max-width: 1100px) 46vw, 380px';
---
<article class:list={['card', `card-${size}`]}>
  <div class="card-media">
    {cover === 'chromium-flow' ? <ChromiumFigure /> : <ResponsiveImage image={cover} alt={coverAlt} sizes={sizes} />}
    <span class="card-badge"><BadgeIcon size={14} aria-hidden="true" />{badge.label}</span>
    {video && <span class="card-video"><Play size={10} fill="currentColor" aria-hidden="true" />Demo video</span>}
  </div>
  <div class="card-body">
    <p class="card-meta"><span>{year} · {field}</span><span class="card-go" aria-hidden="true"><ArrowRight size={17} /></span></p>
    <Heading class="card-title"><a href={`/projects/${project.id}/`}>{title}</a></Heading>
    <p class="card-summary">{summary}</p>
  </div>
</article>
