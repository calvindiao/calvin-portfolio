---
import { ArrowRight } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <section class="page-hero not-found" aria-labelledby="nf-title">
    <div class="shell page-hero-inner">
      <p class="kicker">Error 404</p>
      <h1 id="nf-title">Page not found</h1>
      <p class="page-lead">This page doesn’t exist or has moved.</p>
      <div class="hero-actions"><a class="button primary" href="/#projects">View projects<ArrowRight size={16} aria-hidden="true" /></a><a class="button" href="/writing/">All writing</a></div>
    </div>
  </section>
</Layout>
