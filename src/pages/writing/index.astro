---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import Layout from '../../layouts/Layout.astro';
const posts = (await getCollection('writing')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const projects = new Map((await getCollection('projects')).map(project => [project.id, project.data.title]));
const format = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Layout title="Writing" description="Original technical write-ups by Calvin Diao: Chromium DNS errors, AR panoramic calling, wearable motion capture and two competition robots.">
  <section class="page-hero" aria-labelledby="writing-title">
    <div class="shell page-hero-inner">
            <h1 id="writing-title">Writing</h1>
      <p class="page-lead">Full write-ups from my original blog.</p>
    </div>
  </section>
  <div class="shell writing">
    <ol class="post-list">
      {posts.map(post => (
        <li>
          <a href={post.data.legacyPath}>
            <time datetime={post.data.date}>{format(post.data.date)}</time>
            <span class="post-title">{post.data.title}</span>
            <span class="post-project">{post.data.project ? projects.get(post.data.project) : 'First blog post'}</span>
            <ArrowRight class="post-arrow" size={18} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>
