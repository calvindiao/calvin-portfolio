---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Play, Maximize2, ArrowUpRight, Glasses, Globe, Activity, Bike, AudioLines, FolderOpen, FileText, Minus, Square, X, UserRound, Mail, CodeXml } from '@lucide/astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { getImage } from '../data/images';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const icons = [Glasses, Globe, Activity, Bike, AudioLines];
const posts = (await getCollection('writing')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
---
<section class="workspace lab" aria-label="Calvin's interactive workspace" data-lab data-workspace>
  <div class="desktop-caption" aria-hidden="true"><span>Calvin’s workspace</span><span>Software meets the real world.</span></div>
  <section class="workspace-window welcome-window" data-window="welcome" aria-labelledby="welcome-caption">
    <div class="window-titlebar" data-drag-handle><span id="welcome-caption"><FileText size={14} aria-hidden="true" />Read me</span><span class="window-grip" aria-hidden="true"></span></div>
    <div class="welcome-content"><div class="welcome-portrait"><ResponsiveImage image="avatar.jpg" priority sizes="64px" /></div><p class="welcome-greeting">Hello, I’m</p><h1>Calvin Diao.</h1><p class="welcome-tagline">From circuits <br />to Chromium.</p><p class="welcome-summary">Software & hardware engineer. I build browsers, immersive experiences, and things that move.</p><div class="welcome-links"><a href="https://github.com/calvindiao" target="_blank" rel="noopener noreferrer">GitHub<ArrowUpRight size={13} aria-hidden="true" /></a><a href="https://www.linkedin.com/in/chenhaodiao/" target="_blank" rel="noopener noreferrer">LinkedIn<ArrowUpRight size={13} aria-hidden="true" /></a><a href="mailto:diaochenhao@gmail.com">Email<ArrowUpRight size={13} aria-hidden="true" /></a></div></div>
  </section>
  <section class="workspace-window files-window" data-window="files" aria-labelledby="files-caption">
    <div class="window-titlebar" data-drag-handle><span id="files-caption"><FolderOpen size={14} aria-hidden="true" />Projects</span><span class="window-grip" aria-hidden="true"></span></div>
    <p class="files-hint">Choose a project to explore.</p>
    <div class="project-tabs js-only" role="tablist" aria-label="Choose a project" aria-orientation="vertical">
      {projects.map((project,index)=>{const Icon=icons[index];return <button id={`tab-${project.id}`} role="tab" aria-selected={index===0?'true':'false'} aria-controls={`panel-${project.id}`} tabindex={index===0?0:-1} data-project={project.id}><span class="file-icon"><Icon size={21} aria-hidden="true" /></span><span class="file-name">{project.data.shortTitle}</span><span class="file-year" aria-hidden="true">{project.data.year}</span></button>;})}
    </div>
    <noscript><div class="files-fallback">{projects.map(project=><a href={`/projects/${project.id}/`}>{project.data.shortTitle}<ArrowUpRight size={14} aria-hidden="true" /></a>)}</div></noscript>
    <div class="files-status">5 projects <span>2020–2025</span></div>
  </section>
  <section class="workspace-window viewer-window" data-window="viewer" aria-labelledby="viewer-caption">
    <div class="window-titlebar" data-drag-handle><span id="viewer-caption"><Glasses size={15} aria-hidden="true" /><span data-window-caption>AR Calling</span><span class="window-app">Project viewer</span></span><div class="window-controls js-only"><button data-minimize="viewer" aria-label="Minimize project viewer"><Minus size={13} aria-hidden="true" /></button><button data-maximize="viewer" aria-label="Expand project viewer" aria-pressed="false"><Square size={11} aria-hidden="true" /></button></div></div>
    {projects.map((project,index)=><div class="project-panel" id={`panel-${project.id}`} role="tabpanel" aria-labelledby={`tab-${project.id}`} tabindex="0" hidden={index!==0} data-panel={project.id}>
      <div class:list={['stage-media',{'diagram-media':project.id==='gsoc'}]} data-video={project.data.video} data-video-title={`${project.data.title} demo`}>
        <div class="media-photo"><ResponsiveImage image={project.data.cover} alt={project.data.coverAlt} priority={index===0} sizes="(max-width: 900px) 90vw, 48vw" /><button class="expand-image js-only" data-image={getImage(project.data.cover).src} data-alt={project.data.coverAlt} aria-label={`Enlarge image of ${project.data.title}`}><Maximize2 size={17} aria-hidden="true" /></button>{project.id==='gsoc'&&<span class="media-caption">Conceptual illustration</span>}</div>
        {project.data.video&&<button class="media-play js-only" data-watch aria-label={`Watch demo of ${project.data.title}`}><span class="play-symbol"><Play size={19} fill="currentColor" aria-hidden="true" /></span><span>Watch demo</span></button>}
      </div>
      <div class="stage-info"><div class="project-context"><span>{project.data.field}</span><span>{project.data.year}</span></div><h2>{project.data.title}</h2><p class="project-summary">{project.data.summary}</p><details class="stage-contribution"><summary>What I built</summary><ul class="highlights">{project.data.highlights.map(item=><li>{item}</li>)}</ul></details><div class="stage-actions">{!project.data.video&&<a class="button primary" href={project.data.contributions} target="_blank" rel="noopener noreferrer">View contributions<ArrowUpRight size={16} aria-hidden="true" /></a>}<a class="text-link project-details" href={`/projects/${project.id}/`}>Explore project<ArrowUpRight size={16} aria-hidden="true" /></a></div><div class="stage-meta"><span class="tools">{project.data.tools.join(' / ')}</span>{project.data.video?<a href={`https://www.youtube.com/watch?v=${project.data.video}`} target="_blank" rel="noopener noreferrer">Open on YouTube<ArrowUpRight size={12} aria-hidden="true" /></a>:<a href={project.data.code} target="_blank" rel="noopener noreferrer">Read the code review<ArrowUpRight size={12} aria-hidden="true" /></a>}</div></div>
    </div>)}
    <div class="viewer-status"><span>Real projects, real prototypes.</span><span>Click play to try a demo.</span></div>
  </section>
  <section class="workspace-window floating-window about-window" id="window-about" data-window="about" role="dialog" aria-labelledby="about-caption" hidden>
    <div class="window-titlebar" data-drag-handle><span id="about-caption"><UserRound size={14} aria-hidden="true" />About Calvin</span><div class="window-controls"><button data-close-window="about" aria-label="Close about window"><X size={13} aria-hidden="true" /></button></div></div>
    <div class="desktop-reader"><div class="reader-portrait"><ResponsiveImage image="avatar.jpg" sizes="90px" /></div><h2>Curiosity, with a practical side.</h2><p>I enjoy the whole path from a circuit board to the software running on it. My projects connect electronics, embedded control, cloud video, and Chromium’s networking stack.</p><dl class="reader-experience"><div><dt>Chromium / GSoC</dt><dd>Open-source contributor, 2025</dd></div><div><dt>General Motors</dt><dd>Software Engineer, 2024–2025</dd></div><div><dt>Samsung R&D</dt><dd>Software Development Engineer, 2022–2023</dd></div><div><dt>McMaster University</dt><dd>M.Eng., Computing and Software, 2024–2025</dd></div></dl><a class="button secondary" href="/about/">Full background<ArrowUpRight size={16} aria-hidden="true" /></a></div>
  </section>
  <section class="workspace-window floating-window notes-window" id="window-notes" data-window="notes" role="dialog" aria-labelledby="notes-caption" hidden>
    <div class="window-titlebar" data-drag-handle><span id="notes-caption"><FileText size={14} aria-hidden="true" />Writing</span><div class="window-controls"><button data-close-window="notes" aria-label="Close writing window"><X size={13} aria-hidden="true" /></button></div></div>
    <div class="desktop-reader"><h2>Behind the builds.</h2><p>Original technical notes and project stories.</p><div class="desktop-posts">{posts.map(post=><a href={post.data.legacyPath}><FileText size={18} aria-hidden="true" /><span>{post.data.title}<time datetime={post.data.date}>{post.data.date.slice(0,4)}</time></span><ArrowUpRight size={14} aria-hidden="true" /></a>)}</div><a class="text-link" href="/writing/">All writing<ArrowUpRight size={16} aria-hidden="true" /></a></div>
  </section>
  <div class="desktop-dock js-only" aria-label="Workspace apps"><button data-open-window="viewer" aria-label="Open project viewer"><span class="dock-icon dock-project"><FolderOpen size={25} aria-hidden="true" /></span><span class="dock-label">Projects</span><span class="dock-indicator" data-dock-indicator="viewer"></span></button><button data-open-window="about" aria-label="Open about window"><span class="dock-icon"><UserRound size={24} aria-hidden="true" /></span><span class="dock-label">About</span><span class="dock-indicator" data-dock-indicator="about" hidden></span></button><button data-open-window="notes" aria-label="Open writing window"><span class="dock-icon"><FileText size={24} aria-hidden="true" /></span><span class="dock-label">Writing</span><span class="dock-indicator" data-dock-indicator="notes" hidden></span></button><span class="dock-divider"></span><a href="https://github.com/calvindiao" target="_blank" rel="noopener noreferrer" aria-label="Calvin on GitHub"><span class="dock-icon"><CodeXml size={25} aria-hidden="true" /></span><span class="dock-label">GitHub</span></a><a href="mailto:diaochenhao@gmail.com" aria-label="Email Calvin"><span class="dock-icon dock-mail"><Mail size={24} aria-hidden="true" /></span><span class="dock-label">Email</span></a></div>
  <div class="desktop-help"><span>Drag a title bar to rearrange.</span><button class="js-only" data-reset-workspace>Reset workspace</button></div>
</section>
