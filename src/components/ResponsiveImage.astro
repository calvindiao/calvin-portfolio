---
import { getImage } from '../data/images';
interface Props { image: string; alt?: string; sizes?: string; priority?: boolean; class?: string; }
const { image: key, alt, sizes = '(max-width: 700px) 100vw, 70vw', priority = false, class: className } = Astro.props;
const image = getImage(key);
---
<img src={image.src} srcset={image.srcSet || undefined} width={image.width} height={image.height}
  alt={alt ?? image.alt} sizes={sizes} loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'} decoding="async" class={className} />
